{
  "name": "universal-ai-bi-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "python -m uvicorn backend.main:app --reload --port 8000 --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:backend": "python -m pytest backend/tests",
    "test:all": "vitest run && python -m pytest backend/tests",
    "preview": "vite preview"
  },
  "dependencies": {
